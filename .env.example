# Environment variables for the SHELIFT website (copy to `.env` for local use).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required — API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional overrides for the contact endpoint (defaults live in api/contact.ts).
# CONTACT_FROM must use a domain verified in Resend (SPF/DKIM) once sheliftuganda.org is added.
# CONTACT_TO=sheliftorgan@gmail.com
# CONTACT_FROM="SHELIFT Website <website@sheliftuganda.org>"